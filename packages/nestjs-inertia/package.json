{
  "name": "@johnanthonyeletto/nestjs-inertia",
  "version": "0.1.0",
  "description": "Inertia.js v3 server-side adapter for NestJS",
  "author": "John Eletto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnanthonyeletto/inertiajs-nest.git",
    "directory": "packages/nestjs-inertia"
  },
  "homepage": "https://github.com/johnanthonyeletto/inertiajs-nest/tree/master/packages/nestjs-inertia#readme",
  "bugs": "https://github.com/johnanthonyeletto/inertiajs-nest/issues",
  "keywords": [
    "inertia",
    "inertiajs",
    "nestjs",
    "nest",
    "adapter",
    "ssr",
    "precognition"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin/index.d.ts",
      "default": "./dist/vite-plugin/index.js"
    },
    "./validation/class-validator": {
      "types": "./dist/validation/class-validator.d.ts",
      "default": "./dist/validation/class-validator.js"
    },
    "./validation/zod": {
      "types": "./dist/validation/zod.d.ts",
      "default": "./dist/validation/zod.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nestjs-inertia": "./bin/nestjs-inertia.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.tsbuildinfo",
    "stubs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.14.0",
    "express-session": "^1.17.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "vite": ">=7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "express-session": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.2",
    "zod": "^4.1.0"
  }
}
