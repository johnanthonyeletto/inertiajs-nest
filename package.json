{
  "name": "inertiajs-nest-workspace",
  "private": true,
  "description": "An Inertia.js v3 server-side adapter for NestJS, its demo app, and its conformance harness.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter inertia-nest build && pnpm --filter demo build",
    "build:package": "pnpm --filter inertia-nest build",
    "dev": "pnpm --filter demo dev",
    "start": "pnpm --filter demo start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter inertia-nest test",
    "test:browser": "pnpm --filter demo test:browser",
    "test:conformance": "conformance/run.sh",
    "pack:check": "pnpm build:package && pnpm --filter inertia-nest pack --dry-run"
  },
  "devDependencies": {
    "inertia-nest": "workspace:*"
  }
}
