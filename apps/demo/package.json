{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "description": "A Sequelize-backed CRM and feature tour demonstrating @johnanthonyeletto/nestjs-inertia.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm build:package && pnpm build:server && concurrently -k -n pkg,tsc,nest,vite -c cyan,yellow,blue,magenta \"pnpm:watch:package\" \"pnpm:watch:server\" \"pnpm:serve:dev\" \"vite\"",
    "build:package": "pnpm --filter @johnanthonyeletto/nestjs-inertia build",
    "watch:package": "pnpm --filter @johnanthonyeletto/nestjs-inertia watch",
    "watch:server": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "serve:dev": "node --enable-source-maps --watch dist/main.js",
    "build": "pnpm build:server && pnpm build:client && pnpm build:ssr",
    "build:server": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr",
    "start": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "start:ssr": "nestjs-inertia ssr:start",
    "stop:ssr": "nestjs-inertia ssr:stop",
    "check:ssr": "nestjs-inertia ssr:check",
    "db:fresh": "pnpm build:server && node dist/database/cli.js fresh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test:browser": "node test/browser/browser.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/sequelize": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express-session": "^1.19.0",
    "@johnanthonyeletto/nestjs-inertia": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/react": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
